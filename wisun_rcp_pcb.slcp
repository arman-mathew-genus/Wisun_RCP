  vendor: silabs
  id: EFR32FG28A120F1024GM48
- package: simplicity_sdk
  vendor: silabs
  id: brd4001a
- package: simplicity_sdk
  vendor: silabs
  id: cpc_recommend_vcom_usart
- package: simplicity_sdk
